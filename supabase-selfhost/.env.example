############################################################################
# Self-hosted Supabase – Environment Variables
# Copy to .env and fill in ALL values before running docker compose up
############################################################################

# ── Secrets (CHANGE THESE – generate with: openssl rand -hex 32) ──────
POSTGRES_PASSWORD=your-super-secret-postgres-password
JWT_SECRET=your-super-secret-jwt-secret-at-least-32-characters-long

# ── URLs ──────────────────────────────────────────────────────────────
# The public URL where Supabase API gateway (Kong) is accessible.
# If running on a separate VPS, use that VPS's IP or hostname:
#   http://<SUPABASE_VPS_IP>:8000
# If behind a reverse proxy with HTTPS:
#   https://auth.yourdomain.com
API_EXTERNAL_URL=http://149.102.131.27:8000

# Your Voyagr app URL (GoTrue redirects back here after OAuth)
SITE_URL=https://vibevoyagr.duckdns.org

# Extra redirect URLs (comma-separated) for OAuth callbacks
ADDITIONAL_REDIRECT_URLS=

# ── JWT ───────────────────────────────────────────────────────────────
JWT_EXPIRY=3600

# ── Google OAuth (optional) ──────────────────────────────────────────
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP (optional – for email confirmation, password reset) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@voyagr.app

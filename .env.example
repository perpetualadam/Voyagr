# Voyagr PWA Environment Variables
# Copy this file to .env and fill in your values

# Routing Engines
GRAPHHOPPER_URL=http://localhost:8989
VALHALLA_URL=http://localhost:8002

# Routing Mode (set to 'true' to use OSRM instead of GraphHopper)
USE_OSRM=false

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Database (Railway will use SQLite by default)
DATABASE_URL=sqlite:///voyagr_web.db

# Optional: For production, use PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/dbname

# API Keys (if needed for external services)
# GOOGLE_MAPS_API_KEY=your_key_here
# MAPBOX_API_KEY=your_key_here

# Overpass API Configuration (for speed limit detection)
# Self-hosted Overpass API URL (optional - falls back to public if not set)
# OVERPASS_API_URL=http://your-server-ip:12345/api/interpreter

# Overpass API rate limiting (requests per second)
# Conservative default for self-hosted instance
OVERPASS_RATE_LIMIT=2.0

# Speed limit defaults: uk | us | metric (optional). If unset, region is inferred from lat/lon
# (US/UK boxes + metric elsewhere). Use this when inference is wrong (e.g. Ireland vs UK).
# SPEED_LIMIT_REGION=metric

# Posted speed limits: never use TomTom Traffic Flow freeFlowSpeed by default (not a legal limit; often high).
# SPEED_LIMIT_USE_TRAFFIC_FLOW=true

# ============================================================================
# SUPABASE AUTH (MULTI-USER)
# ============================================================================
# Works with both Supabase Cloud and self-hosted Supabase.
#
# For SELF-HOSTED: run supabase-selfhost/setup.sh on your VPS, then copy
# the generated values from supabase-selfhost/generated-keys.txt here.
# URL will be: https://yourdomain.com/supabase
#
# For CLOUD: use your Supabase project URL and keys from the dashboard.
#
# Public (safe to expose to browser via /api/config):
SUPABASE_URL=
SUPABASE_ANON_KEY=
#
# Server-only:
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
#
# If true, the app can enforce login for cloud features (future).
REQUIRE_LOGIN=false

# Optional: secret for POST /api/admin/promo-coupons (create trial / lifetime promo codes).
# Send header: X-Voyagr-Admin-Key: <same value>
# VOYAGR_COUPON_ADMIN_SECRET=

# Optional: gate ops/debug routes (monitoring, cache-clear, debug-route, add-camera, etc.).
# When unset, those routes stay open (current behaviour). When set, require header:
#   X-Voyagr-Admin-Key: <VOYAGR_ADMIN_SECRET>
# Does not affect /api/route, geocode, app-settings, hazard-preferences, or sign-in flows.
# VOYAGR_ADMIN_SECRET=

# When true, API routes wrapped with promo enforcement require active promo trial/lifetime in SQLite.
# Default off — turn on after users can redeem codes. Trip analytics (/api/trip-analytics) uses this.
# VOYAGR_ENFORCE_PROMO_PREMIUM=true

# ============================================================================
# DEPLOYMENT / DISCOVERABILITY
# ============================================================================
# Comma-separated origins for browser CORS — list every hostname you use to open the PWA.
# VOYAGR_PUBLIC_ORIGIN (below) is also merged into allowed origins so you need not duplicate your main URL here.
# (e.g. private app host + www variant). Example two-domain setup:
#   App (keep quiet):     https://nav.yourdomain.com
#   Public / Stripe return: https://yourdomain.com  (thank-you page or same app on second vhost)
# ALLOWED_ORIGINS=https://nav.yourdomain.com,https://yourdomain.com,https://www.yourdomain.com
#
# Buy Me a Coffee + Patreon use their own URLs in VOYAGR_* below — no extra domain needed for those.
# For Stripe Checkout return URLs, set STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL (or VOYAGR_PUBLIC_ORIGIN)
# to the domain you want users to land on after pay (often your "public" site), not necessarily the app host.
#
# When true, sends noindex headers, meta robots, and serves robots.txt Disallow: /
# (reduces casual search discovery; does not replace a secret URL or VPN).
# VOYAGR_BLOCK_SEARCH_INDEXING=true
#
# Canonical SEO / AEO / LLMO origin (no trailing slash). Used for <link rel="canonical">,
# Open Graph, sitemap.xml, robots.txt Sitemap:, and /llms.txt absolute URLs.
# Prefer this over VOYAGR_PUBLIC_ORIGIN when the public marketing host differs from CORS helpers.
# Falls back to VOYAGR_PUBLIC_ORIGIN, then https://vibevoyager.org
# VOYAGR_SITE_URL=https://vibevoyager.org
#
# Optional dedicated social share image (defaults to /static/images/icons/icon-512.png).
# VOYAGR_OG_IMAGE_PATH=/static/images/icons/icon-512.png
# VOYAGR_OG_IMAGE_WIDTH=512
# VOYAGR_OG_IMAGE_HEIGHT=512
#
# Optional sitemap <lastmod> override (YYYY-MM-DD). Default: mtime of voyagr/seo.py.
# VOYAGR_SITEMAP_LASTMOD=2026-08-10

# ============================================================================
# SUPPORT: STRIPE = SUBSCRIPTIONS | BMC + PATREON = TIPS (optional)
# ============================================================================
# Stripe — recurring subscription only (create a Product with a recurring Price in Dashboard).
# One Premium button in the app: Payment Link wins if set; otherwise server Checkout (below).
# VOYAGR_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/...
#
# One-off tips / patronage (external platforms):
# VOYAGR_BUYMEACOFFEE_URL=https://www.buymeacoffee.com/yourname
# VOYAGR_PATREON_URL=https://www.patreon.com/yourname
#
# Stripe Checkout session from this app = subscription mode (pip install -r requirements-web.txt)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx   # must be a recurring Price, not one-time
# Optional free trial for Checkout-created subscriptions (integer days). Unrelated to domain;
# set STRIPE_SUCCESS_URL to domain B if you want users to return there after subscribing.
# STRIPE_SUBSCRIPTION_TRIAL_DAYS=14
# STRIPE_SUCCESS_URL=https://your-host/
# STRIPE_CANCEL_URL=https://your-host/
# Or: VOYAGR_PUBLIC_ORIGIN=https://your-host
#
# Legacy env name (still works if STRIPE_SUBSCRIPTION_PRICE_ID is unset):
# STRIPE_DONATE_PRICE_ID=price_xxx

# Optional short notice shown under Voyager Premium (not legal advice — adjust for your terms)
# VOYAGR_SERVICE_REGION_NOTE=UK only: subscriptions and tips are intended for United Kingdom users.

# ============================================================================
# PRODUCTION: ONE SOURCE OF TRUTH + SUPABASE REBUILD
# ============================================================================
# "One place" means: keep the real secrets only on the server (e.g. /opt/voyagr/.env),
# load them via systemd EnvironmentFile= or your process manager, and do not scatter
# duplicate copies in random shells or unencrypted chat. The *list* of names belongs in
# this file; the *values* live in one protected env file per machine.
#
# If you recreate self-hosted Supabase (new docker volumes / new setup.sh / new JWT secret),
# update every value that was derived from the old project, then restart Gunicorn:
#
# Server (.env on VPS1, or wherever voyagr runs):
#   SUPABASE_URL          → new API URL (e.g. https://auth.example.com or Kong URL)
#   SUPABASE_ANON_KEY     → new anon key from generated-keys.txt or dashboard
#   SUPABASE_JWT_SECRET   → must match the new stack (HS256) or rely on JWKS + SUPABASE_URL
#
# Same anon key + URL must appear in whatever you expose to the browser (often the same
# SUPABASE_* vars if /api/config reads from env). If those drift, sign-in works on one
# side and fails on the other.
#
# You do NOT get a new anon key just because 90 days passed — only if you rotate keys or
# rebuild the Supabase project.

# ============================================================================
# SECURITY / DEPLOYMENT (recommended for Internet-facing hosts)
# ============================================================================
# Comma-separated API keys for @require_auth endpoints (when used). If unset in production,
# Voyagr auto-generates /opt/voyagr/.api_key on first start. The PWA does not send this key.
# API_KEYS=your-long-random-1,your-long-random-2
#
# Trust reverse proxy X-Forwarded-* (Railway, nginx, Cloudflare). Enables correct client
# IP for rate limiting + Werkzeug ProxyFix for scheme/host.
# VOYAGR_TRUST_PROXY=1
#
# Flask-Limiter shared storage (multi-worker gunicorn). Default memory:// per process.
# On VPS with Redis: RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# If Redis is down at startup, Voyagr falls back to memory:// automatically.
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
#
# GET / (PWA shell) per-IP rate limit. Defaults are generous for normal reloads/tabs.
# PAGE_RATE_LIMIT_REQUESTS=60
# PAGE_RATE_LIMIT_WINDOW_SECONDS=60
#
# Max HTTP request body size in bytes (Flask/Werkzeug 413). Default 1 MiB.
# MAX_CONTENT_LENGTH_BYTES=1048576
#
# TomTom: by default the traffic *raster* layer is fetched via /api/tomtom/traffic-tile/...
# so TOMTOM_API_KEY is not injected into the page. To restore old behavior (key in HTML):
# TOMTOM_EXPOSE_CLIENT_KEY=1
# TOMTOM_API_KEY=your_tomtom_key

# Voyagr PWA Environment Variables
# Copy this file to .env and fill in your values

# Routing Engines
GRAPHHOPPER_URL=http://localhost:8989
VALHALLA_URL=http://localhost:8002

# Routing Mode (set to 'true' to use OSRM instead of GraphHopper)
USE_OSRM=false

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Database (Railway will use SQLite by default)
DATABASE_URL=sqlite:///voyagr_web.db

# Optional: For production, use PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/dbname

# API Keys (if needed for external services)
# GOOGLE_MAPS_API_KEY=your_key_here
# MAPBOX_API_KEY=your_key_here

# Overpass API Configuration (for speed limit detection)
# Self-hosted Overpass API URL (optional - falls back to public if not set)
# OVERPASS_API_URL=http://your-server-ip:12345/api/interpreter

# Overpass API rate limiting (requests per second)
# Conservative default for self-hosted instance
OVERPASS_RATE_LIMIT=2.0

# ============================================================================
# SUPABASE AUTH (MULTI-USER)
# ============================================================================
# Works with both Supabase Cloud and self-hosted Supabase.
#
# For SELF-HOSTED: run supabase-selfhost/setup.sh on your VPS, then copy
# the generated values from supabase-selfhost/generated-keys.txt here.
# URL will be: https://yourdomain.com/supabase
#
# For CLOUD: use your Supabase project URL and keys from the dashboard.
#
# Public (safe to expose to browser via /api/config):
SUPABASE_URL=
SUPABASE_ANON_KEY=
#
# Server-only:
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
#
# If true, the app can enforce login for cloud features (future).
REQUIRE_LOGIN=false

# ============================================================================
# DEPLOYMENT / DISCOVERABILITY
# ============================================================================
# Comma-separated origins for browser CORS — list every hostname you use to open the PWA
# (e.g. private app host + www variant). Example two-domain setup:
#   App (keep quiet):     https://nav.yourdomain.com
#   Public / Stripe return: https://yourdomain.com  (thank-you page or same app on second vhost)
# ALLOWED_ORIGINS=https://nav.yourdomain.com,https://yourdomain.com,https://www.yourdomain.com
#
# Buy Me a Coffee + Patreon use their own URLs in VOYAGR_* below — no extra domain needed for those.
# For Stripe Checkout return URLs, set STRIPE_SUCCESS_URL / STRIPE_CANCEL_URL (or VOYAGR_PUBLIC_ORIGIN)
# to the domain you want users to land on after pay (often your "public" site), not necessarily the app host.
#
# When true, sends noindex headers, meta robots, and serves robots.txt Disallow: /
# (reduces casual search discovery; does not replace a secret URL or VPN).
# VOYAGR_BLOCK_SEARCH_INDEXING=true

# ============================================================================
# SUPPORT: STRIPE = SUBSCRIPTIONS | BMC + PATREON = TIPS (optional)
# ============================================================================
# Stripe — recurring subscription only (create a Product with a recurring Price in Dashboard).
# One Premium button in the app: Payment Link wins if set; otherwise server Checkout (below).
# VOYAGR_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/...
#
# One-off tips / patronage (external platforms):
# VOYAGR_BUYMEACOFFEE_URL=https://www.buymeacoffee.com/yourname
# VOYAGR_PATREON_URL=https://www.patreon.com/yourname
#
# Stripe Checkout session from this app = subscription mode (pip install -r requirements-web.txt)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx   # must be a recurring Price, not one-time
# Optional free trial for Checkout-created subscriptions (integer days). Unrelated to domain;
# set STRIPE_SUCCESS_URL to domain B if you want users to return there after subscribing.
# STRIPE_SUBSCRIPTION_TRIAL_DAYS=14
# STRIPE_SUCCESS_URL=https://your-host/
# STRIPE_CANCEL_URL=https://your-host/
# Or: VOYAGR_PUBLIC_ORIGIN=https://your-host
#
# Legacy env name (still works if STRIPE_SUBSCRIPTION_PRICE_ID is unset):
# STRIPE_DONATE_PRICE_ID=price_xxx

[Unit]
Description=Voyagr Navigation PWA
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/opt/voyagr
Environment="PATH=/opt/voyagr/venv/bin"
Environment="FLASK_ENV=production"
EnvironmentFile=-/opt/voyagr/.env
Environment="VALHALLA_URL=http://localhost:8002"
Environment="GRAPHHOPPER_URL=http://localhost:8989"
# Tune workers: ~ (2 × CPU cores) + 1 for CPU-bound work; fewer if RAM is tight.
# Override without editing this file:
#   sudo systemctl edit voyagr.service
#   [Service]
#   ExecStart=
#   ExecStart=/opt/voyagr/venv/bin/gunicorn --workers 6 --threads 4 --bind 127.0.0.1:5000 --timeout 120 --graceful-timeout 60 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 voyagr_web:app
ExecStart=/opt/voyagr/venv/bin/gunicorn --workers 4 --threads 4 --bind 127.0.0.1:5000 --timeout 120 --graceful-timeout 60 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 voyagr_web:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target


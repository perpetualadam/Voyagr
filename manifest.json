{
  "name": "Voyagr Navigation",
  "short_name": "Voyagr",
  "description": "Full-featured navigation app with route planning, cost estimation, and trip tracking",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#667eea",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/static/images/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["navigation", "travel", "utilities"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Calculate Route",
      "short_name": "Route",
      "description": "Calculate a new route",
      "url": "/?mode=route",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-route.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Trip History",
      "short_name": "History",
      "description": "View your trip history",
      "url": "/?mode=history",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-history.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Voice Control",
      "short_name": "Voice",
      "description": "Start voice navigation",
      "url": "/?mode=voice",
      "icons": [
        {
          "src": "/static/images/icons/shortcut-voice.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+voyagr",
      "url": "/?route=%s"
    },
    {
      "protocol": "geo",
      "url": "/?geo=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.voyagr.app",
      "id": "com.voyagr.app"
    }
  ],
  "prefer_related_applications": true
}


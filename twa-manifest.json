{
  "packageId": "com.voyagr.app",
  "host": "vibevoyagr.duckdns.org",
  "name": "Voyagr Navigation",
  "launcherName": "Voyagr",
  "display": "standalone",
  "themeColor": "#667eea",
  "navigationColor": "#667eea",
  "navigationColorDark": "#4c5ecf",
  "navigationDividerColor": "#ffffff",
  "navigationDividerColorDark": "#1a1a1a",
  "backgroundColor": "#ffffff",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://vibevoyagr.duckdns.org/static/images/icons/icon-512.png",
  "maskableIconUrl": "https://vibevoyagr.duckdns.org/static/images/icons/icon-512-maskable.png",
  "shortcuts": [
    {
      "name": "Calculate Route",
      "short_name": "Route",
      "url": "/?mode=route",
      "icons": [
        {
          "src": "/static/images/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Trip History",
      "short_name": "History",
      "url": "/?mode=history",
      "icons": [
        {
          "src": "/static/images/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://vibevoyagr.duckdns.org/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": true
    },
    "playBilling": {
      "enabled": false
    }
  },
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://vibevoyagr.duckdns.org/",
  "minSdkVersion": 23,
  "orientation": "any",
  "fingerprints": [
    {
      "name": "upload-key",
      "value": "REPLACE_WITH_YOUR_SHA256_FINGERPRINT"
    }
  ],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "signingKey": {
    "path": "./upload-keystore.jks",
    "alias": "voyagr"
  },
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "splashScreenFadeOutDuration": 300,
  "enableChromeOsTabletMode": false
}
